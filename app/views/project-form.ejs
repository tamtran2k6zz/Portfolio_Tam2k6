<%- include('partials/header') %><section class="panel"><h1><%= project ? 'Sửa dự án' : 'Thêm dự án' %></h1><form method="post" action="<%= project ? '/admin/projects/'+project.id+'/edit' : '/admin/projects' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Tên dự án<input name="title" maxlength="120" value="<%= project?.title || '' %>" required></label><label>Công nghệ<input name="stack" maxlength="200" value="<%= project?.stack || '' %>" required></label><label>Mô tả<textarea name="description" maxlength="3000" rows="8" required><%= project?.description || '' %></textarea></label><label>Đường dẫn (không bắt buộc)<input name="link" type="url" maxlength="500" value="<%= project?.link || '' %>"></label><button>Lưu dự án</button><a href="/admin">Quay lại</a></form></section><%- include('partials/footer') %>
