<%- include('partials/header') %><section class="panel"><h1><%= project.title %></h1><p class="tag"><%= project.stack %></p><% const visual = projectVisual(project); if (visual.real && visual.image) { %><img class="project-detail-image" src="/static/images/<%= visual.image %>" alt="Giao diện <%= project.title %>" width="1600" height="780"><% } %><p class="bio"><%= project.description %></p><% if(project.link) { %><a class="button" href="<%= project.link %>" rel="noopener noreferrer" target="_blank"><%= project.link.startsWith("https://github.com/") ? "Xem dự án trên GitHub" : "Xem liên kết dự án" %></a><% } %><p><a href="/">← Về trang chủ</a></p></section><%- include('partials/footer') %>
