<!doctype html>
<html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#f7f8f4"><meta name="description" content="Portfolio cá nhân về phát triển ứng dụng web, triển khai hệ thống và An toàn thông tin."><title><%= isPortfolio ? profile.full_name + ' — Portfolio' : 'Portfolio | Đề 13' %></title><link rel="stylesheet" href="/static/style.css"><% if(isPortfolio) { %><script src="/static/motion.js" defer></script><% } %></head>
<body class="<%= isPortfolio ? 'portfolio-page' : 'app-page' %>"><a class="skip-link" href="#main-content">Bỏ qua điều hướng</a><% if(isPortfolio) { %><div class="scroll-progress" aria-hidden="true"></div><% } %>
<header class="top"><a class="brand" href="/" aria-label="Portfolio trang chủ"><span class="brand-mark" aria-hidden="true">t.</span><span><%= isPortfolio ? profile.full_name : 'Portfolio cá nhân' %></span></a><nav aria-label="Điều hướng chính"><% if(isPortfolio) { %><a href="#projects">Dự án</a><a href="#about">Giới thiệu</a><a href="#contact" class="nav-contact">Liên hệ ↗</a><% } else { %><a href="/">Trang chủ</a><% } %><% if(user) { %><a href="/admin">Quản trị</a><form class="inline" method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="quiet">Đăng xuất</button></form><% } else if(!isPortfolio) { %><a href="/login">Admin</a><% } %></nav></header><main id="main-content" class="<%= isPortfolio ? 'portfolio-main' : 'app-main' %>">
