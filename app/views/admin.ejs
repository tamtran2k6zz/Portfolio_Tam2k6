<%- include('partials/header') %><section><p class="eyebrow">ĐĂNG NHẬP: <%= user.username %></p><h1>Quản trị Portfolio</h1><p>Chỉnh sửa nội dung và kiểm tra kết quả ở trang công khai.</p></section>
<section class="panel"><h2>Thông tin cá nhân</h2><form method="post" action="/admin/profile"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Họ tên<input name="full_name" value="<%= profile.full_name %>" maxlength="100" required></label><label>Tiêu đề<input name="headline" value="<%= profile.headline %>" maxlength="150" required></label><label>Giới thiệu<textarea name="bio" rows="4" maxlength="2000" required><%= profile.bio %></textarea></label><label>Email<input name="email" type="email" value="<%= profile.email %>" maxlength="150" required></label><label>GitHub<input name="github_url" type="url" value="<%= profile.github_url %>" maxlength="500"></label><button>Lưu hồ sơ</button></form></section>
<section class="panel"><h2>Dự án</h2><a class="button" href="/admin/projects/new">Thêm dự án</a><div class="table-wrap"><table><thead><tr><th>ID</th><th>Dự án</th><th>Thao tác</th></tr></thead><tbody><% projects.forEach(project => { %><tr><td><%= project.id %></td><td><%= project.title %></td><td><a href="/admin/projects/<%= project.id %>/edit">Sửa</a><form class="inline" method="post" action="/admin/projects/<%= project.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Xóa</button></form></td></tr><% }) %></tbody></table></div></section>
<section class="panel"><h2>Kỹ năng</h2><form method="post" action="/admin/skills"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Tên kỹ năng<input name="name" maxlength="80" required></label><label>Mức độ / mô tả<input name="level" maxlength="80" required></label><button>Thêm kỹ năng</button></form><div class="skills"><% skills.forEach(skill => { %><div class="skill"><strong><%= skill.name %></strong><span><%= skill.level %></span><form method="post" action="/admin/skills/<%= skill.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Xóa</button></form></div><% }) %></div></section>
<section class="panel"><h2>Đổi mật khẩu</h2><p>Mật khẩu mới cần ít nhất 16 ký tự. Sau khi đổi, mọi phiên đăng nhập bị hủy.</p><form method="post" action="/admin/password"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Mật khẩu hiện tại<input type="password" name="current_password" autocomplete="current-password" required></label><label>Mật khẩu mới<input type="password" name="new_password" minlength="16" maxlength="128" autocomplete="new-password" required></label><button>Đổi mật khẩu</button></form></section>
<%- include('partials/footer') %>
